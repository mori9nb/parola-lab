FROM node:22-alpine AS frontend
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home parola
COPY --chown=parola:parola backend/ ./
COPY --from=frontend --chown=parola:parola /build/dist /app/frontend
ENV SERVE_FRONTEND=true FRONTEND_DIRECTORY=/app/frontend SESSION_COOKIE_SECURE=true AUTH_REGISTRATION_ENABLED=false
USER parola
EXPOSE 10000
CMD ["python", "-m", "app.deploy"]
