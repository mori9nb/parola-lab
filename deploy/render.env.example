# Enter real values only in Render Environment, never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=YOUR_EXISTING_KEY
# Copy the exact working model name from backend/.env:
GEMINI_MODEL=YOUR_EXISTING_MODEL
SESSION_COOKIE_SECURE=true
AUTH_REGISTRATION_ENABLED=false
# Render automatically supplies RENDER_EXTERNAL_URL.
# For a custom domain later: PUBLIC_ORIGIN=https://your-domain.example
